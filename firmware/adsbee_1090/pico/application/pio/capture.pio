; 1090MHz Mode S receive path with software bit decisions.
; PIO0: 4x preamble_matcher (round robin). PIO1: 4x pulse_sampler, one per preamble matcher.
; Both run at 48MHz: 24 cycles per 0.5us chip.

.program preamble_matcher
; Matches the comparator output against the 8us preamble, chip by chip, and tolerates a number of wrong samples.
;
; ISR holds the chip pattern (loaded by the CPU): 2 unused bits, then 2 bits per chip for 15 chips, first chip first:
;   0b11 = expect HI, 0b10 = expect LO, 0b0x = don't check.
; A checked chip is sampled 4 times, at cycles 5, 9, 13 and 17 of the chip (9 to 21 cycles after its nominal start). Every sample that differs from the
; expectation takes one count out of y (the mismatch budget) and delays the rest of the pattern by one cycle. The
; candidate is dropped when the budget is used up.

.define pulses_gpio 19
.define public mismatch_budget 4
.define samples_per_chip 4

fail_lo:
    jmp y-- lo_next                 ; Wrong sample in a LO chip: spend budget, or fall through and start over.
.wrap_target
public follow_irq:
    set pins, 0                     ; Demod pin low: not receiving.
    mov osr, isr                    ; Reload the chip pattern...
    out null, 2                     ; ...which has 15 chips: the sampler starts half a microsecond before the data.
    wait 1 irq 4 rel                ; Round robin: wait for the previous matcher to take a candidate.
    wait 0 gpio pulses_gpio
    wait 1 gpio pulses_gpio         ; Rising edge: candidate first preamble pulse. Chip 0 starts here.
    irq set 5 rel                   ; Let the next matcher look for the next edge.
public set_budget:
    set y, mismatch_budget
chip:                               ; Cycle 0 of the chip (4 cycles after the edge for chip 0).
    out x, 1                        ; 0 | Check this chip?
    jmp !x skip_chip                ; 1
    out x, 1                        ; 2 | Expected level.
    jmp !x expect_lo                ; 3
expect_hi:
    set x, (samples_per_chip - 1)    ; 4
hi_sample:
    jmp pin hi_next                 ; 5 + 4n
    jmp y-- hi_next                 ; Wrong sample: spend budget...
    jmp follow_irq                  ; ...or start over.
hi_next:
    jmp x-- hi_sample [2]           ; 6:8 + 4n
    jmp chip_end [1]                ; 21:22
expect_lo:
    set x, (samples_per_chip - 1)    ; 4
lo_sample:
    jmp pin fail_lo                 ; 5 + 4n
lo_next:
    jmp x-- lo_sample [2]           ; 6:8 + 4n
    jmp chip_end [1]                ; 21:22
skip_chip:
    out x, 1 [20]                   ; 2:22 | Discard the expected level.
chip_end:
    jmp !osre chip                  ; 23
matched:
    set pins, 1                     ; Preamble matched: the sampler starts and the CPU timestamps the rising edge.
    ; Wait about 43us, until the RSSI low pass has settled and before a 56 bit message ends.
    set y, 1
rssi_wait_outer:
    set x, 31
rssi_wait_inner:
    jmp x-- rssi_wait_inner [31]
    jmp y-- rssi_wait_outer
    irq wait 0 rel                  ; IRQ 0+SM: the CPU samples RSSI, and clears the flag once the samples are in.
.wrap

% c-sdk {
// Chip pattern for preamble chips 0 to 14: pulses in chips 0, 2, 7 and 9; quiet chips 4, 5 and 11 to 14 checked.
// The chips next to a pulse are skipped (pulse tails, comparator level recovery). Chip 15 is left to the sampler.
static const uint32_t kPreambleMatcherChipPattern = 0b00110011001010001100110010101010;

static inline void preamble_matcher_program_init(PIO pio, uint sm, uint offset, uint pulses_pin, uint demod_pin,
                                                 float div, bool waiting) {
    pio_sm_config c = preamble_matcher_program_get_default_config(offset);
    pio_sm_set_consecutive_pindirs(pio, sm, pulses_pin, 1, false);
    pio_gpio_init(pio, demod_pin);
    pio_sm_set_consecutive_pindirs(pio, sm, demod_pin, 1, true);
    sm_config_set_in_pins(&c, pulses_pin);
    sm_config_set_jmp_pin(&c, pulses_pin);
    sm_config_set_set_pins(&c, demod_pin, 1);
    sm_config_set_out_shift(&c, false, false, 32);  // OSR shifts left: first chip in the MSBs.
    sm_config_set_in_shift(&c, false, false, 32);
    sm_config_set_clkdiv(&c, div);
    if (!waiting) {
        pio_sm_exec(pio, sm, pio_encode_irq_set(true, 4));  // The first matcher of the ring starts right away.
    }
    pio_sm_init(pio, sm, offset + preamble_matcher_offset_follow_irq, &c);
    // Load the chip pattern into the ISR through the (otherwise unused) TX FIFO.
    pio_sm_put(pio, sm, kPreambleMatcherChipPattern);
    pio_sm_exec(pio, sm, pio_encode_pull(false, true));
    pio_sm_exec(pio, sm, pio_encode_mov(pio_isr, pio_osr));
}
%}

.program pulse_sampler
; Samples the comparator output at 12MHz (12 samples per bit) while its preamble matcher holds the demod pin high.
; Autopush hands 32 samples at a time to a DMA channel. The CPU parks the state machine at idle again when the
; capture is complete.

public idle:
    jmp pin start                   ; Demod pin (JMP pin) high?
    jmp idle
start:
    pull noblock                    ; TX FIFO pull: triggers the DMA transfer that timestamps the message.
.wrap_target
    in pins, 1 [3]                  ; One comparator sample every 4 cycles.
.wrap

% c-sdk {
static inline void pulse_sampler_program_init(PIO pio, uint sm, uint offset, uint pulses_pin, uint demod_pin,
                                              float div) {
    pio_sm_config c = pulse_sampler_program_get_default_config(offset);
    pio_sm_set_consecutive_pindirs(pio, sm, demod_pin, 1, false);
    pio_sm_set_consecutive_pindirs(pio, sm, pulses_pin, 1, false);
    sm_config_set_in_pins(&c, pulses_pin);
    sm_config_set_jmp_pin(&c, demod_pin);
    sm_config_set_in_shift(&c, false, true, 32);  // ISR shifts left (first sample in the MSB), autopush at 32.
    sm_config_set_out_shift(&c, false, false, 32);
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_NONE);  // The TX FIFO is used for the timestamp trigger.
    sm_config_set_clkdiv(&c, div);
    pio_sm_init(pio, sm, offset + pulse_sampler_offset_idle, &c);
}
%}
