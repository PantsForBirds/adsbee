              <bitOffset>4</bitOffset>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>UP</name>
                  <value>1</value>
                  <description>The timer counts up. When counting up, the timer starts from a value of 0x0.</description>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DOWN</name>
                  <value>0</value>
                  <description>The timer counts down.</description>
                </enumeratedValue>
              </enumeratedValues>
            </field>
