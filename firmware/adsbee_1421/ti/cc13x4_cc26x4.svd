                  <value>0</value>
                  <description>Enable</description>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>RESERVED6</name>
              <description>[7:6] Software should not rely on the value of a reserved. Writing any other value than the reset value may result in undefined behavior.</description>
              <bitWidth>2</bitWidth>
              <bitOffset>6</bitOffset>
              <access>read-only</access>
            </field>
            <field>
              <name>REDMATCHFORCE</name>
              <description>[5:5] Force redundancy match.  If set to 1, repair configuration encoded in the flash
