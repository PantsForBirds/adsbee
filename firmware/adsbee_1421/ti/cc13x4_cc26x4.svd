              <bitOffset>10</bitOffset>
              <access>read-only</access>
            </field>
            <field>
              <name>PULSECNTLDDIS</name>
              <description>[9:9] Override pulse counter enable.
When set, the state machine pulse counter will not be loaded when a
command is initiated.</description>
              <bitWidth>1</bitWidth>
              <bitOffset>9</bitOffset>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <value>1</value>
