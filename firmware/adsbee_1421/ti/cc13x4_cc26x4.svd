            <field>
              <name>DIO1</name>
              <description>[8:8] Sets the state of the pin that is configured as DIO#1, if the corresponding DOE47_0 bitfield is set.</description>
              <bitWidth>1</bitWidth>
              <bitOffset>8</bitOffset>
              <access>read-write</access>
            </field>
            <field>
              <name>RESERVED1</name>
              <description>[7:1] Software should not rely on the value of a reserved. Writing any other value than the reset value may result in undefined behavior.</description>
              <bitWidth>7</bitWidth>
