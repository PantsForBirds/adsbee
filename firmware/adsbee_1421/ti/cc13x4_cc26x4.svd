                </enumeratedValue>
                <enumeratedValue>
                  <name>SOFTWARE</name>
                  <value>1</value>
                  <description>The interrupt or event line is in software mode. Software must clear the RIS.</description>
                </enumeratedValue>
                <enumeratedValue>
