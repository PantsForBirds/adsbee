                  <description>Both edges</description>
                </enumeratedValue>
                <enumeratedValue>
                  <name>NEG</name>
                  <value>1</value>
                  <description>Negative edge</description>
                </enumeratedValue>
                <enumeratedValue>
                  <name>POS</name>
                  <value>0</value>
                  <description>Positive edge</description>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
