        <register>
          <name>USER_ID</name>
          <addressOffset>0x294</addressOffset>
          <size>32</size>
          <description>User Identification.
Reading this register and the FCFG1:ICEPICK_DEVICE_ID register is the only supported way of identifying a device.
The value of this register will be written to AON_PMCTL:JTAGUSERCODE by boot FW while in safezone.</description>
          <access>read-write</access>
