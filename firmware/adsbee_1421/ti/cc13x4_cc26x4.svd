              <access>read-write</access>
            </field>
            <field>
              <name>REF_ON_IDLE</name>
              <description>[6:6] Enable ADCREF in IDLE state.

0: Disabled in IDLE state
1: Enabled in IDLE state

Keep ADCREF enabled when ADC0.SMPL_MODE = 0.
Recommendation: Enable ADCREF always when ADC0.SMPL_CYCLE_EXP is less than 0x6 (21.3us sampling time).</description>
              <bitWidth>1</bitWidth>
              <bitOffset>6</bitOffset>
              <access>read-write</access>
            </field>
            <field>
              <name>IOMUX</name>
              <description>[5:5] Internal. Only to be used through TI provided API.</description>
              <bitWidth>1</bitWidth>
