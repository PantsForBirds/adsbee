                </enumeratedValue>
                <enumeratedValue>
                  <name>DIS</name>
                  <value>0</value>
                  <description>The match interrupt is disabled for match events. Additionally, output triggers on match events are prevented.</description>
                </enumeratedValue>
              </enumeratedValues>
            </field>
