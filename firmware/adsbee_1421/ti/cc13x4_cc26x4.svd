                  <value>0</value>
                  <description>Disable</description>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PUMPCLKEN</name>
              <description>[8:8] Allows direct control of the pump oscillator which is used to generate pumpclk.
Normally, enable/disable of pumpclk is under NoWrapper state machine
control.  This bit allows system to enable the clock independently.</description>
              <bitWidth>1</bitWidth>
              <bitOffset>8</bitOffset>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
