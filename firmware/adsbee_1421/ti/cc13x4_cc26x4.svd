        <register>
          <name>RXDATA</name>
          <addressOffset>0x130</addressOffset>
          <size>32</size>
          <description>RXDATA Register. Reading this register returns value in the RX FIFO pointed by the current FIFO read pointer. If the RX FIFO is empty, the last read value is returned. Writing has not effect and is ignored.</description>
          <access>read-write</access>
          <fields>
            <field>
              <name>DATA</name>
              <description>[31:0] Received Data</description>
