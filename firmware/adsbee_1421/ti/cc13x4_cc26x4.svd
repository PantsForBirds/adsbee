                </enumeratedValue>
                <enumeratedValue>
                  <name>ALL0</name>
                  <value>0</value>
                  <description>Set to all 0</description>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DATAPATEN</name>
              <description>[12:12] Enable data pattern.  Data pattern select in DATAPATSEL field will override data
from CMDDATA registers for use as program or verify data.</description>
              <bitWidth>1</bitWidth>
              <bitOffset>12</bitOffset>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <value>1</value>
                  <description>Enable</description>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <value>0</value>
                  <description>Disable</description>
                </enumeratedValue>
              </enumeratedValues>
            </field>
